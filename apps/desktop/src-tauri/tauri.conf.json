{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HAL100",
  "version": "1.0.2",
  "identifier": "com.hal100.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @hal100/agent-kernel build && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter @hal100/agent-kernel build && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HAL100",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 18
        },
        "visible": false,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["app"],
    "icon": ["icons/icon.png"]
  }
}

        "schemaVersion": 1,
        "disposition": "task",
        "taskKind": "inspect_runtime"
      }
    },
    {
      "id": "pi-open-diagnose-whats-wrong",
      "category": "task",
      "input": { "prompt": "这套本地 AI 环境哪儿不对劲，先查清楚。" },

{
  "protocolVersion": 4,
  "limits": {
    "maxRequiredTools": 4,
    "maxActionPlans": 1,
    "maxToolResultBytes": 131072
  },
  "tools": [
    {
      "name": "hal100.inspect_system_summary",
      "effect": "readOnly",
      "prerequisites": [],
      "requiresNativeConfirmation": false,
      "validArguments": { "detail": "summary" },
      "invalidArguments": [{ "detail": "full" }, { "detail": "summary", "path": "/" }]
    },
    {
      "name": "hal100.inspect_runtime_catalog",
      "effect": "readOnly",
      "prerequisites": [],
      "requiresNativeConfirmation": false,
      "validArguments": { "detail": "summary" },
      "invalidArguments": [{}, { "detail": "summary", "extra": true }]
    },
    {
      "name": "hal100.plan_model_start",
      "effect": "actionPlan",
      "prerequisites": ["hal100.inspect_runtime_catalog"],
      "requiresNativeConfirmation": true,
      "validArguments": { "modelId": "managed-model-1" },
      "invalidArguments": [{ "modelId": "" }, { "modelId": "managed-model-1", "force": true }]
    },
    {
      "name": "hal100.plan_model_removal",
      "effect": "actionPlan",
      "prerequisites": ["hal100.inspect_runtime_catalog"],
      "requiresNativeConfirmation": true,
      "validArguments": { "modelId": "managed-model-1" },
      "invalidArguments": [{}, { "modelId": "managed-model-1", "deleteSource": true }]
    },
    {
      "name": "hal100.inspect_environment_diagnostics",
      "effect": "readOnly",
      "prerequisites": [],
      "requiresNativeConfirmation": false,
      "validArguments": { "target": "full" },
      "invalidArguments": [{ "target": "summary" }, { "target": "full", "paths": true }]
    },
    {
      "name": "hal100.plan_diagnostic_repair",
      "effect": "actionPlan",
      "prerequisites": ["hal100.inspect_environment_diagnostics"],
      "requiresNativeConfirmation": true,
      "validArguments": { "reportId": "diagnostic-1", "findingId": "finding-1" },
      "invalidArguments": [
        { "reportId": "diagnostic-1" },
        { "reportId": "diagnostic-1", "findingId": "", "force": true }
      ]
    },
    {
      "name": "hal100.plan_engine_install",
      "effect": "actionPlan",
      "prerequisites": ["hal100.inspect_runtime_catalog"],
      "requiresNativeConfirmation": true,
      "validArguments": { "target": "llama.cpp" },
      "invalidArguments": [{ "target": "other" }, { "target": "llama.cpp", "version": "latest" }]
    },
    {
      "name": "hal100.plan_engine_remove",
      "effect": "actionPlan",
      "prerequisites": ["hal100.inspect_runtime_catalog"],
      "requiresNativeConfirmation": true,
      "validArguments": { "target": "llama.cpp" },
      "invalidArguments": [{}, { "target": "llama.cpp", "force": true }]
    },
    {
      "name": "hal100.inspect_opencode_status",
      "effect": "readOnly",
      "prerequisites": [],
      "requiresNativeConfirmation": false,
      "validArguments": { "target": "opencode" },
      "invalidArguments": [{ "target": "other" }, { "target": "opencode", "includeConfig": true }]
    },
    {
      "name": "hal100.plan_opencode_configuration",
      "effect": "actionPlan",
      "prerequisites": ["hal100.inspect_opencode_status"],
      "requiresNativeConfirmation": true,
      "validArguments": { "target": "opencode" },
      "invalidArguments": [{}, { "target": "opencode", "overwrite": true }]
    },
    {
      "name": "hal100.search_model_catalog",
      "effect": "readOnly",
      "prerequisites": [],
      "requiresNativeConfirmation": false,
      "validArguments": { "query": "Qwen GGUF" },
      "invalidArguments": [{ "query": "Q" }, { "query": "Qwen", "source": "huggingFace" }]
    },
    {
      "name": "hal100.inspect_model_repository",
      "effect": "readOnly",
      "prerequisites": ["hal100.search_model_catalog"],
      "requiresNativeConfirmation": false,
      "validArguments": { "repository": "acme/model" },
      "invalidArguments": [
        { "repository": "../model" },
        { "repository": "acme/model", "revision": "main" }
      ]
    },
    {
      "name": "hal100.plan_model_download",
      "effect": "actionPlan",
      "prerequisites": ["hal100.inspect_model_repository"],
      "requiresNativeConfirmation": true,
      "validArguments": { "remotePath": "model-Q4_K_M.gguf" },
      "invalidArguments": [
        { "remotePath": "../model.gguf" },
        { "remotePath": "model.gguf", "destination": "/tmp" }
      ]
    }
  ]
}

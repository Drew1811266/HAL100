{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HAL100 inference engine acceptance evidence ledger v4",
  "description": "A reviewed, redacted ledger of exact inference-engine support cells. V4 binds each new performance profile to a typed model-evidence fingerprint; the three pre-v4 records remain explicitly scope-missing and measurement-missing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": {
      "const": 4
    },
    "records": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "engine": {
      "enum": [
        "llamaCpp",
        "ollama",
        "mlxLm",
        "vllm",
        "sglang",
        "tensorRtLlm",
        "openVino",
        "mlcLlm",
        "lmDeploy"
      ]
    },
    "adapterId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "variant", "contractRevision"],
      "properties": {
        "engine": {
          "$ref": "#/$defs/engine"
        },
        "variant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "contractRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9._/-]+$"
        }
      }
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "evidenceKind": {
      "enum": [
        "officialContract",
        "protocolQualification",
        "platformRuntime",
        "engineIdentity",
        "modelDeploymentIdentity",
        "runtimeProfileLifecycle",
        "stability"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "assertion"],
      "properties": {
        "kind": {
          "$ref": "#/$defs/evidenceKind"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(README\\.md|contracts/|crates/|docs/)"
        },
        "assertion": {
          "$ref": "#/$defs/boundedText"
        }
      }
    },
    "stability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workloadRevision",
        "attempts",
        "concurrency",
        "p95LatencyMs",
        "maxLatencyMs",
        "totalPromptTokens",
        "totalCompletionTokens",
        "wallTimeMs"
      ],
      "properties": {
        "workloadRevision": {
          "const": "openai-short-chat-v1"
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "p95LatencyMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000
        },
        "maxLatencyMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000
        },
        "totalPromptTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "totalCompletionTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "wallTimeMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600000
        }
      }
    },
    "resilience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancellationVerified",
        "failedSwitchRollbackVerified",
        "restartCompensationVerified"
      ],
      "properties": {
        "cancellationVerified": {
          "type": "boolean"
        },
        "failedSwitchRollbackVerified": {
          "type": "boolean"
        },
        "restartCompensationVerified": {
          "type": "boolean"
        }
      }
    },
    "completeResilience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cancellationVerified",
        "failedSwitchRollbackVerified",
        "restartCompensationVerified"
      ],
      "properties": {
        "cancellationVerified": {
          "const": true
        },
        "failedSwitchRollbackVerified": {
          "const": true
        },
        "restartCompensationVerified": {
          "const": true
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "adapterId",
        "instanceId",
        "originFingerprint",
        "configRevision",
        "protocolCapabilityHash",
        "platform",
        "architecture",
        "accelerator",
        "deployment",
        "status",
        "verifiedAtMs",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "adapterId": {
          "$ref": "#/$defs/adapterId"
        },
        "instanceId": {
          "$ref": "#/$defs/instanceId"
        },
        "originFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "configRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854776000
        },
        "protocolCapabilityHash": {
          "$ref": "#/$defs/fingerprint"
        },
        "platform": {
          "enum": ["macOs", "windows", "linux"]
        },
        "architecture": {
          "enum": ["aarch64", "x86_64"]
        },
        "accelerator": {
          "enum": ["cpu", "metal", "cuda", "rocm", "vulkan", "sycl", "intelGpu", "intelNpu"]
        },
        "deployment": {
          "enum": ["local", "remote"]
        },
        "status": {
          "enum": ["reserved", "connected", "managed", "verifiedExternal"]
        },
        "verifiedAtMs": {
          "type": "integer",
          "minimum": 1
        },
        "engineVersion": {
          "type": ["string", "null"],
          "maxLength": 512
        },
        "deploymentFingerprint": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "modelRevision": {
          "type": ["string", "null"],
          "maxLength": 512
        },
        "hostSummary": {
          "type": ["string", "null"],
          "maxLength": 512,
          "pattern": "^(macos|windows|linux)/(aarch64|x86_64)/(cpu|metal|cuda|rocm|vulkan|sycl|intel_gpu|intel_npu)$"
        },
        "stability": {
          "anyOf": [
            {
              "$ref": "#/$defs/stability"
            },
            {
              "type": "null"
            }
          ]
        },
        "resilience": {
          "anyOf": [
            {
              "$ref": "#/$defs/resilience"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "hostAttestation": {
          "$ref": "#/$defs/hostAttestation"
        },
        "modelEvidence": {
          "anyOf": [
            {
              "$ref": "#/$defs/modelEvidence"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": ["managed", "verifiedExternal"]
              }
            }
          },
          "then": {
            "required": ["modelRevision", "hostSummary", "resilience", "hostAttestation"],
            "properties": {
              "modelRevision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "not": {
                  "pattern": "^model-id-sha256:"
                }
              },
              "hostSummary": {
                "$ref": "#/$defs/boundedText"
              },
              "resilience": {
                "$ref": "#/$defs/completeResilience"
              },
              "evidence": {
                "minItems": 7,
                "maxItems": 7
              }
            },
            "anyOf": [
              {
                "required": ["engineVersion"],
                "properties": {
                  "engineVersion": {
                    "$ref": "#/$defs/boundedText"
                  }
                }
              },
              {
                "required": ["deploymentFingerprint"],
                "properties": {
                  "deploymentFingerprint": {
                    "$ref": "#/$defs/fingerprint"
                  }
                }
              }
            ]
          }
        }
      ]
    },
    "hostAttestation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "platform", "architecture", "accelerator"],
          "properties": {
            "kind": {
              "const": "legacyHostSummaryV1"
            },
            "platform": {
              "enum": ["macOs", "windows", "linux"]
            },
            "architecture": {
              "enum": ["aarch64", "x86_64"]
            },
            "accelerator": {
              "enum": ["cpu", "metal", "cuda", "rocm", "vulkan", "sycl", "intelGpu", "intelNpu"]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "platform",
            "architecture",
            "accelerator",
            "probeRevision",
            "deviceClassFingerprint"
          ],
          "properties": {
            "kind": {
              "const": "nativeHostProbeV1"
            },
            "platform": {
              "enum": ["macOs", "windows", "linux"]
            },
            "architecture": {
              "enum": ["aarch64", "x86_64"]
            },
            "accelerator": {
              "enum": ["cpu", "metal", "cuda", "rocm", "vulkan", "sycl", "intelGpu", "intelNpu"]
            },
            "probeRevision": {
              "const": "host-capabilities-v3"
            },
            "deviceClassFingerprint": {
              "$ref": "#/$defs/fingerprint"
            }
          }
        }
      ]
    },
    "modelEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "algorithm", "valueFingerprint"],
      "properties": {
        "kind": {
          "enum": [
            "contentDigest",
            "repositoryRevision",
            "deploymentFingerprint",
            "catalogIdentity"
          ]
        },
        "algorithm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[A-Za-z0-9._/-]+$"
        },
        "valueFingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      }
    }
  }
}

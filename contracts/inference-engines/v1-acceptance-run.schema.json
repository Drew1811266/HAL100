{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HAL100 inference engine acceptance run artifact",
  "description": "A redacted, explicit live-test artifact. It is not a formal promotion record; optional resilience checks must all pass before human review can promote the run.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "adapterId",
    "instanceId",
    "originFingerprint",
    "configRevision",
    "protocolCapabilityHash",
    "platform",
    "architecture",
    "accelerator",
    "deployment",
    "outcome",
    "observedAtMs",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 96 },
    "adapterId": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "variant", "contractRevision"],
      "properties": {
        "engine": { "type": "string" },
        "variant": { "type": "string", "minLength": 1, "maxLength": 96 },
        "contractRevision": { "type": "string", "minLength": 1, "maxLength": 96 }
      }
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "originFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "configRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "protocolCapabilityHash": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "platform": { "enum": ["macOs", "windows", "linux"] },
    "architecture": { "enum": ["aarch64", "x86_64"] },
    "accelerator": {
      "enum": ["cpu", "metal", "cuda", "rocm", "vulkan", "sycl", "intelGpu", "intelNpu"]
    },
    "deployment": { "enum": ["local", "remote"] },
    "outcome": { "enum": ["passed", "failed"] },
    "observedAtMs": { "type": "integer", "minimum": 1 },
    "engineVersion": { "type": ["string", "null"], "maxLength": 512 },
    "deploymentFingerprint": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "modelRevision": { "type": ["string", "null"], "maxLength": 512 },
    "hostSummary": { "type": ["string", "null"], "maxLength": 512 },
    "stability": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["attempts", "concurrency", "maxLatencyMs"],
      "properties": {
        "attempts": { "type": "integer", "minimum": 1, "maximum": 100 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 16 },
        "maxLatencyMs": { "type": "integer", "minimum": 0, "maximum": 120000 }
      }
    },
    "resilience": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "cancellationVerified",
        "failedSwitchRollbackVerified",
        "restartCompensationVerified"
      ],
      "properties": {
        "cancellationVerified": { "type": "boolean" },
        "failedSwitchRollbackVerified": { "type": "boolean" },
        "restartCompensationVerified": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 0,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "source", "assertion"],
        "properties": {
          "kind": {
            "enum": [
              "officialContract",
              "protocolQualification",
              "platformRuntime",
              "engineIdentity",
              "modelDeploymentIdentity",
              "runtimeProfileLifecycle",
              "stability"
            ]
          },
          "source": { "type": "string", "minLength": 1, "maxLength": 256 },
          "assertion": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  }
}
